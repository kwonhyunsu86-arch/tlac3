function card(t){return `<article class="item"><div class="item-body" role="button" tabindex="0" data-open="${t.id}"><span class="num">#${t.id}</span><h3>${esc(t.name)}</h3><p class="eng">${esc(t.eng)}</p><p class="desc">${esc(t.concept)}</p></div><button class="star" data-star="${t.id}" aria-label="${bookmarks.includes(t.id)?'보관함에서 제외':'보관함에 담기'}">${bookmarks.includes(t.id)?'⭐':'☆'}</button></article>`}
function pills(){return `<div class="pill-row">${categories.map(c=>`<button class="pill ${category===c.id?'active':''}" data-cat="${c.id}">${esc(c.name.replace(/ \(.+/,''))}</button>`).join('')}</div>`}
function render(){document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));$('headCount').textContent=`${techniques.length}가지 수업 기법 · 보관함 ${bookmarks.length}`;let items=filtered();let inner='';if(tab==='home'){inner=`<h2 class="section-title">어떤 수업 고민이 있으신가요?</h2><p class="sub">상황을 선택하면 활용할 만한 기법을 바로 찾아드립니다.</p><div class="quick-grid">${situations.slice(0,4).map((s,i)=>`<button class="quick" data-situation="${i}"><span>${s.emoji}</span><b>${s.title}</b></button>`).join('')}</div><h2 class="section-title" style="margin-top:25px">기법 찾아보기</h2><p class="sub">최근 사용하는 기술을 골라 메모를 남겨 보세요.</p><div class="list">${items.slice(0,10).map(card).join('')}</div><button class="pill" style="width:100%;margin-top:12px" data-go="all">63개 기법 전체 보기 →</button>`}else if(tab==='situations'){inner=`<h2 class="section-title">상황별 기법 찾기</h2><p class="sub">추천은 참고용입니다. 교사의 판단에 따라 선택하세요.</p><div class="quick-grid">${situations.map((s,i)=>`<button class="quick" data-situation="${i}" style="${situation===s?'border-color:#7375c4;background:#f3f3ff':''}"><span>${s.emoji}</span><b>${s.title}</b></button>`).join('')}</div>${situation?`<h2 class="section-title" style="margin-top:24px">${situation.emoji} ${esc(situation.title)}</h2><div class="list">${items.map(card).join('')}</div>`:''}`}else{inner=`<h2 class="section-title">${tab==='saved'?'내 수업 보관함':'63가지 수업 기법'}</h2>${tab==='saved'?'<p class="sub">별표를 누른 기법과 메모를 이 기기에 저장합니다.</p>':pills()}<p class="sub">${items.length}개 기법</p><div class="list">${items.map(card).join('')||'<div class="empty">조건에 맞는 기법이 없습니다.<br>검색어 또는 분류를 바꿔 보세요.</div>'}</div>${tab==='saved'&&items.length?'<button class="pill" style="width:100%;margin-top:14px" data-print="yes">🖨 보관함 인쇄</button>':''}`}$('main').innerHTML=inner;}
function switchTab(next){tab=next;category='all';situation=null;render();window.scrollTo(0,0)}
function openSheet(title,eng,num,html,foot=''){lastFocus=document.activeElement;$('sheetTitle').textContent=title;$('sheetEng').textContent=eng;$('sheetNum').textContent=num;$('sheetContent').innerHTML=html;$('sheetFoot').innerHTML=foot;$('overlay').classList.add('open');document.body.style.overflow='hidden';$('close').focus();}
function panel(title,text,cls=''){return `<section class="panel ${cls}"><h3>${esc(title)}</h3><p>${esc(text)}</p></section>`}
function openTechnique(id){const t=techniques.find(x=>x.id===id);if(!t)return;current=id;let html=panel('🎯 핵심 개념 · 원서 기반 재구성',t.concept)+`<section class="panel"><h3>⚡ 실행 단계</h3><ol>${t.steps.map(x=>`<li>${esc(x)}</li>`).join('')}</ol></section>`+panel('💬 교실 적용 대본 · 제작 예시',t.script,'warm')+panel('💡 현장 팁',t.tip,'note')+panel('📖 원서 및 적용 맥락',`원서: Teach Like a Champion 3.0 · Technique ${id} · 업로드 PDF ${t.sourcePage||'확인 필요'}쪽부터\n\n이 설명은 원서를 한국어로 요약·재구성한 것이며, 대본과 실행 단계는 직접 번역문이 아닙니다.`,'blue');if(t.revisionNote)html+=panel('⚠️ 설명 시 주의점',t.revisionNote);if(t.elementaryNote)html+=panel('🇰🇷 한국 초등교실 적용 제안 · 원서와 구분',t.elementaryNote,'blue');html+=`<section class="panel"><h3>📝 나의 적용 메모 · 이 기기에 자동 저장</h3><textarea id="memo" placeholder="수업에 활용할 아이디어를 기록해 보세요">${esc(memos[id]||'')}</textarea></section>`;let footer=`<button class="footbtn" id="prev">◀ 이전</button><button class="footbtn primary" id="sheetStar">${bookmarks.includes(id)?'⭐ 저장됨':'☆ 보관함'}</button><button class="footbtn" id="next">다음 ▶</button>`;openSheet(t.name,t.eng,`TECHNIQUE ${id}`,html,footer);$('memo').addEventListener('input',e=>{memos[id]=e.target.value;save()});$('prev').onclick=()=>openTechnique(id===1?63:id-1);$('next').onclick=()=>openTechnique(id===63?1:id+1);$('sheetStar').onclick=()=>{toggleStar(id);$('sheetStar').textContent=bookmarks.includes(id)?'⭐ 저장됨':'☆ 보관함'};}
function toggleStar(id){bookmarks=bookmarks.includes(id)?bookmarks.filter(x=>x!==id):[...bookmarks,id];save();render()}
function openPrinciples(){current=null;openSheet('수업을 이끄는 5대 원리','Chapter 1 · Mental Models','TLAC 3.0',tlacPrincipleCorrections.map((p,i)=>panel(`${i+1}. ${principleTitles[i]}`,p)).join('')+panel('자료 성격','원서 1장의 핵심 취지를 간추린 비공식 한국어 요약입니다.'))}
function closeSheet(){$('overlay').classList.remove('open');document.body.style.overflow='';current=null;lastFocus?.focus?.()}
function printSaved(){const items=techniques.filter(t=>bookmarks.includes(t.id));$('printArea').innerHTML='<h1>TLAC 3.0 · 나의 수업 노트</h1>'+items.map(t=>`<div class="print-tech"><h3>#${t.id} ${esc(t.name)}</h3><p>${esc(t.concept)}</p><p><strong>나의 메모:</strong> ${esc(memos[t.id]||'')}</p></div>`).join('');window.print()}
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>switchTab(b.dataset.tab)));
$('principlesBtn').onclick=openPrinciples;$('close').onclick=closeSheet;$('overlay').addEventListener('click',e=>{if(e.target===$('overlay'))closeSheet()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSheet();if((e.key==='Enter'||e.key===' ')&&e.target.matches('[data-open]')){e.preventDefault();openTechnique(+e.target.dataset.open)}});
$('search').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();if(query&&tab!=='all')tab='all';render()});$('main').addEventListener('click',e=>{let b=e.target.closest('[data-open],[data-star],[data-situation],[data-cat],[data-go],[data-print]');if(!b)return;if(b.dataset.open)openTechnique(+b.dataset.open);else if(b.dataset.star)toggleStar(+b.dataset.star);else if(b.dataset.situation!==undefined){tab='situations';situation=situations[+b.dataset.situation];render();window.scrollTo({top:0,behavior:'smooth'})}else if(b.dataset.cat){category=b.dataset.cat;render()}else if(b.dataset.go)switchTab(b.dataset.go);else if(b.dataset.print)printSaved()});
render();</script></body></html>
