;padding:1px 0 10px;scrollbar-width:none}.pill-row::-webkit-scrollbar{display:none}.pill{border:1px solid var(--line);background:white;border-radius:100px;padding:9px 13px;white-space:nowrap;color:#425069;font-size:12px;font-weight:700}.pill.active{background:var(--navy);color:#fff;border-color:var(--navy)}.list{display:grid;gap:10px}.item{display:flex;gap:12px;align-items:center;border:1px solid var(--line);border-radius:17px;padding:15px;background:#fff;box-shadow:0 3px 10px #19255305}.item-body{flex:1;min-width:0;cursor:pointer}.num{display:inline-block;background:#eef1ff;color:var(--indigo);padding:4px 7px;font-weight:850;border-radius:7px;font-size:11px}.item h3{font-size:15px;margin:8px 0 3px;letter-spacing:-.4px}.eng{font-size:11px;color:#7e8799;margin:0 0 7px}.desc{font-size:12px;color:#657085;line-height:1.65;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-line}.star{align-self:flex-start;background:#f7f8fd;border:0;border-radius:11px;padding:9px;font-size:21px;min-width:44px;min-height:44px}.empty{text-align:center;color:var(--muted);padding:42px 10px;line-height:1.8}.bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:520px;display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border-top:1px solid var(--line);padding:9px 6px calc(8px + env(safe-area-inset-bottom));z-index:10;box-shadow:0 -8px 30px #19255310}.tab{background:none;border:0;color:#828da3;display:flex;align-items:center;flex-direction:column;gap:4px;padding:6px 0;min-height:48px;font-size:11px;font-weight:750}.tab span{font-size:21px}.tab.active{color:var(--indigo)}.overlay{position:fixed;inset:0;background:#09112bc0;z-index:25;display:none;align-items:flex-end;justify-content:center}.overlay.open{display:flex}.sheet{height:min(93dvh,950px);width:100%;max-width:520px;background:#f8f9fc;border-radius:24px 24px 0 0;display:flex;flex-direction:column;overflow:hidden;padding-bottom:env(safe-area-inset-bottom)}.sheet-head{background:var(--navy);color:white;padding:17px 19px 16px;flex-shrink:0}.sheet-line{display:flex;justify-content:space-between;align-items:start;gap:12px}.sheet-num{color:#ffe3a0;font-size:12px;font-weight:900}.sheet-head h2{font-size:20px;line-height:1.3;margin:6px 0}.sheet-eng{font-size:12px;color:#c6cdef}.xbtn{background:#ffffff22;border:0;border-radius:10px;color:white;padding:9px 12px;font-size:18px;min-width:44px;min-height:44px}.sheet-content{padding:16px;overflow-y:auto;flex:1;overscroll-behavior:contain}.panel{background:#fff;border:1px solid var(--line);padding:15px;border-radius:15px;margin-bottom:12px}.panel h3{font-size:13px;margin:0 0 9px;color:var(--indigo)}.panel p,.panel li{white-space:pre-line;font-size:13px;line-height:1.85;margin:0;color:#34415a}.panel ol{padding-left:21px;margin:0}.panel li{margin-bottom:7px}.panel.warm{background:#fff7e7;border-color:#f6dcab}.panel.warm h3{color:#956515}.panel.blue{background:#edf6ff;border-color:#cde2f8}.panel.note{background:#f0f8f1;border-color:#d3e7d4}.panel textarea{width:100%;border:1px solid #cdd5e4;border-radius:10px;padding:12px;min-height:100px;resize:vertical;background:#fff;font-size:14px}.small{font-size:11px!important;color:#657085!important}.sheet-foot{display:flex;gap:8px;padding:11px 13px;border-top:1px solid var(--line);background:white}.footbtn{flex:1;border:1px solid #d9dfeb;background:#fff;padding:12px 4px;border-radius:11px;font-size:12px;font-weight:750}.footbtn.primary{background:#fff4db;border-color:#ffe0a0;color:#775309}.footer-text{color:#7a8598;text-align:center;font-size:11px;padding:15px;line-height:1.6}.print-area{display:none}@media print{.head,.bottom,.page,.overlay,.footer-text{display:none!important}.print-area{display:block!important;background:white;padding:15px}.print-tech{break-inside:avoid;border-bottom:1px solid #aaa;margin-bottom:15px;padding-bottom:12px}.print-tech h3{font-size:15px}.print-tech p{white-space:pre-wrap;font-size:12px}}@med