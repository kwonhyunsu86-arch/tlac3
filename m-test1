</style></head><body><div class="app"><header class="head"><div class="brand"><div class="mark">TLAC<br>3.0</div><div><h1>수업 마스터 툴킷</h1><small>63가지 기법 · 교사용 모바일 가이드</small></div></div><label class="search"><span aria-hidden="true">⌕</span><input id="search" placeholder="기법명, 수업 상황, 키워드 검색" aria-label="기법 검색"></label><div class="head-stats"><span id="headCount">63가지 수업 기법</span><button id="principlesBtn">🧠 5대 원리 보기</button></div></header><main class="page" id="main"></main><footer class="footer-text">원서 기반 비공식 한국어 요약·재구성 자료입니다.<br>교실 대본·초등 적용 제안은 원문의 직접 번역이 아닙니다.</footer></div><nav class="bottom" aria-label="화면 이동"><button class="tab active" data-tab="home"><span>⌂</span>홈</button><button class="tab" data-tab="all"><span>▦</span>전체 기법</button><button class="tab" data-tab="situations"><span>◈</span>상황별</button><button class="tab" data-tab="saved"><span>☆</span>보관함</button></nav><div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="sheetTitle"><div class="sheet"><div class="sheet-head"><div class="sheet-line"><div><span class="sheet-num" id="sheetNum"></span><h2 id="sheetTitle"></h2><div class="sheet-eng" id="sheetEng"></div></div><button class="xbtn" id="close" aria-label="닫기">✕</button></div></div><div class="sheet-content" id="sheetContent"></div><div class="sheet-foot" id="sheetFoot"></div></div></div><section class="print-area" id="printArea"></section><script>
// Revised TLAC 3.0 dataset retained from desktop edition.
    const categories = [
      { id: 'all', name: '전체 보기 (63)', chapter: 'All Techniques' },
      { id: 'ch2', name: '수업 준비 (1~5)', chapter: 'Ch 2. Lesson Preparation' },
      { id: 'ch3', name: '이해도 점검 (6~14)', chapter: 'Ch 3. Check for Understanding' },
      { id: 'ch4', name: '학문적 분위기 (15~19)', chapter: 'Ch 4. Academic Ethos' },
      { id: 'ch5', name: '수업 구조 (20~26)', chapter: 'Ch 5. Lesson Structures' },
      { id: 'ch6', name: '속도 조절 (27~31)', chapter: 'Ch 6. Pacing' },
      { id: 'ch7', name: '발문 참여 비율 (32~37)', chapter: 'Ch 7. Ratio Through Questioning' },
      { id: 'ch8', name: '글쓰기 참여 비율 (38~42)', chapter: 'Ch 8. Ratio Through Writing' },
      { id: 'ch9', name: '토론 참여 비율 (43~46)', chapter: 'Ch 9. Ratio Through Discussion' },
      { id: 'ch10', name: '절차와 루틴 (47~51)', chapter: 'Ch 10. Procedures and Routines' },
      { id: 'ch11', name: '높은 행동 기대치 (52~58)', chapter: 'Ch 11. High Behavioral Expectations' },
      { id: 'ch12', name: '동기 부여와 신뢰 (59~63)', chapter: 'Ch 12. Motivation and Trust' }
    ];

    // 63개 기법 전체 데이터베이스
    const techniques = [
      // Ch 2. 수업 준비 (1~5)
      { id: 1, cat: 'ch2', name: '모범 답안 계획', eng: 'Exemplar Planning', tags: ['작업기억', '수업준비'],
        concept: '교사가 던질 핵심 질문에 대해 학생들이 내놓기를 기대하는 이상적인 정답을 수업 전에 직접 글이나 계산식으로 써보는 기법입니다. 수업 중 교사의 작업 기억(Working Memory) 부하를 덜어주어 학생의 답변을 더 깊이 경청하고 오개념을 즉각 포착하게 해줍니다.',
        steps: ['수업 중 가장 중요한 핵심 발문 1~2개를 선정한다.', '기대하는 핵심 어휘와 논리 구조가 담긴 모범 답안을 직접 손으로 작성한다.', '수업 중 클립보드에 들고 다니며 학생들의 실제 답안과 1초 만에 대조한다.'],
        script: '(교사의 사전 준비 노트)\n발문: "조나스가 사과를 가져간 이유는 무엇인가?"\n모범 답안: "사과의 색깔이 순간적으로 변하는 생경한 현상(붉은색의 첫 인식)에 호기심과 혼란을 느껴 이를 직접 검증해 보기 위해서이다."',
        tip: '동료 교사들과 각자 작성한 모범 답안을 비교하며 토론하는 "모범 답안 스파링"은 최고의 전문적 학습공동체 활동입니다.' },
      { id: 2, cat: 'ch2', name: '오류 대비 계획', eng: 'Plan for Error', tags: ['오개념예측', '수업준비'],
        concept: '학생들이 학습 과정에서 저지를 법한 대표적인 실수나 오개념을 미리 예측하고, 그 오류가 실제로 발생했을 때 어떻게 대응할지(보조 발문, 재지도 방법) 사전에 계획하는 기법입니다.',
        steps: ['학생의 눈높이에서 과제를 풀어보며 빠지기 쉬운 함정 2~3가지를 적는다.', '각 오류 발생 시 던질 조건부 대응 계획(If/Then)을 세운다.', '관찰 기록지에 예상 오류 목록을 적어두고 순회 시 빈도를 체크한다.'],
        script: '"많은 친구들이 다항식 나눗셈에서 뺄셈을 할 때 부호 바꾸기를 잊곤 합니다. 만약 나머지가 이상하게 나온다면 2번째 줄의 부호를 다시 점검해 보세요."',
        tip: '오류를 미리 예상하면 실제 수업에서 학생들이 틀렸을 때 교사가 당황하거나 짜증을 내지 않고 침착하게 대응할 수 있습니다.' },
      { id: 3, cat: 'ch2', name: '전달 방식 설계', eng: 'Delivery Moves', tags: ['참여방식', '시간관리'],
        concept: '준비된 질문을 어떤 참여 방식(짝 대화, 무작위 지목, 글쓰기 등)으로 다룰지, 누구를 호명할지, 각 활동에 몇 분을 배분할지(Time Stamp)를 지도안 여백에 구체적으로 표기하는 기법입니다.',
        steps: ['질문의 무게에 따라 참여 방식(MOP)을 매칭한다.', '발언 기회를 줄 특정 학생(풍향계 역할 학생, 조용한 학생)을 미리 메모한다.', '각 단계 옆에 소요 시간이나 실제 시계 시각(예: 10:15까지)을 기입한다.'],
        script: '(지도안 메모 예시)\n[10:15 - 3분] 5번 문항: 2분간 Silent Solo 글쓰기 -> 1분간 짝 대화 -> 지수, 현우 콜드 콜 예정.',
        tip: '시간이 부족할 때 과감히 생략할 문항(Can skip)을 미리 정해두면 수업 막바지에 쫓기듯 끝나는 것을 막을 수 있습니다.' },
      { id: 4, cat: 'ch2', name: '이중 계획', eng: 'Double Plan', tags: ['학습지설계', '학생중심'],
        concept: '교사가 무엇을 설명할 것인가만 계획하는 것이 아니라, 매 순간 "학생들은 구체적으로 무엇을 하고 있어야 하는가"를 나란히 설계하는 기법입니다.',
        steps: ['교사의 활동 옆에 학생의 행동(필기, 밑줄 긋기, 표 채우기)을 1:1로 매칭한다.', '유인물 배부 시간을 줄이도록 모든 자료와 필기란이 통합된 학생용 패킷(Packet)을 구성한다.', '본문 인용문에는 줄 번호(Line Numbers)를 매겨 찾는 시간을 아낀다.'],
        script: '"선생님이 3문단을 읽는 동안, 여러분은 본문 왼쪽 여백의 표에 주인공의 감정 변화를 나타내는 단어 3개를 찾아 적습니다."',
        tip: '학습지 안에 일찍 끝낸 학생들을 위한 심화 질문(Spicy Question)을 함께 넣어두면 대기 시간의 공백을 없앨 수 있습니다.' },
      { id: 5, cat: 'ch2', name: '지식 정리표', eng: 'Knowledge Organizers', tags: ['장기기억', '배경지식'],
        concept: '단원 학습을 시작할 때 고차원적 사고의 밑거름이 되는 필수 배경지식(핵심 어휘, 연표, 인물, 기본 공식 등)을 한 페이지에 압축해 제공하는 시각적 참조 도구입니다.',
        steps: ['단원 이해에 필수적인 핵심 개념과 어휘를 추려 1쪽 분량 표로 정리한다.', '절반으로 접어 스스로 퀴즈를 낼 수 있도록 좌우 2열 구조(용어/정의)로 배치한다.', '단원 첫날 배부하고 매 수업 도입부나 숙제로 짝 퀴즈 및 자가 인출에 활용한다.'],
        script: '"지식 정리표를 꺼내 세로로 접어 정의 부분을 가리세요. 지금부터 2분간 짝과 번갈아 가며 1번부터 5번 용어의 뜻을 말해보는 퀴즈를 진행합니다."',
        tip: '단원이 끝난 뒤 주는 시험 요약본(Study Guide)이 아닙니다. 단원 시작 전에 제공하여 모든 학생의 배경지식 출발선을 같게 맞춰주는 사다리입니다.' },

      // Ch 3. 이해도 점검 (6~14)
      { id: 6, cat: 'ch3', name: '자기 보고 대체하기', eng: 'Replace Self-Report', tags: ['이해도점검', '발문'],
        concept: '"다 이해했니?", "질문 있는 사람?"처럼 학생의 부정확한 주관적 자기 보고에 의존하는 질문을 없애고, 실제 이해 여부를 즉각 검증하는 객관적 표적 발문(Targeted Questions)으로 대체하는 기법입니다.',
        steps: ['설명 후 습관적인 "이해됐지?"라는 말을 삼킨다.', '핵심 개념을 찌르는 짧고 객관적인 질문 2~3개를 미리 준비해 던진다.', '콜드 콜로 학급의 표본 학생들을 지목해 1분 이내에 이해도를 스캔한다.'],
        script: '❌ "소수와 합성수의 차이 다 알겠지?"\n⭕ "1은 소수일까, 합성수일까, 아니면 둘 다 아닐까? 민준이 대답해 볼까? 그럼 가장 작은 짝수 소수는 무엇이지, 서연아?"',
        tip: '엄지손가락을 올리거나 내리게 하는 확인법 역시 주관적 자기 보고이므로 객관적 정답을 묻는 질문으로 바꾸어야 합니다.' },
      { id: 7, cat: 'ch3', name: '인출 연습', eng: 'Retrieval Practice', tags: ['장기기억', '망각곡선'],
        concept: '배운 내용을 잊어버리기 시작할 무렵(전략적 지연 후), 교재를 보지 않고 기억 속에서 끄집어내어 적용하게 함으로써 에빙하우스 망각 곡선을 늦추고 장기기억을 강화하는 기법입니다.',
        steps: ['어제, 지난주, 지난달에 배운 핵심 내용을 묻는 짧은 복습 코너를 상시 배치한다.', '책이나 노트를 덮고 오직 기억에만 의존해 답을 인출하게 한다.', '단순 암기 확인을 넘어 다른 개념과 연결하거나 새로운 예시를 들게(정교화) 한다.'],
        script: '"모두 책을 덮으세요. 3일 전에 배운 직육면체 겉넓이 구하는 원리를 떠올려 봅시다. 옆면 전체의 넓이를 한 번에 구하려면 무엇과 무엇을 곱해야 했나요?"',
        tip: '인출 연습은 점수에 반영하지 않는 부담 없는 퀴즈(Low-stakes) 형태로 자주 진행할 때 학생들의 뇌가 가장 활발히 작동합니다.' },
      { id: 8, cat: 'ch3', name: '서식 표준화', eng: 'Standardize the Format', tags: ['순회관찰', '효율성'],
        concept: '학생들이 학습지나 공책의 정해진 동일한 위치에, 통일된 형태로 답과 풀이 과정을 적게 하여 교사가 순회 시 단 1초 만에 정오답을 파악할 수 있게 공간을 규격화하는 기법입니다.',
        steps: ['학습지에 풀이 공간과 최종 답안 상자(Box)의 위치를 고정한다.', '핵심 조건에 밑줄을 긋거나 최종 답에 네모 표시를 하도록 지시한다.', '교사는 순회하며 모든 학생의 동일한 위치만 빠르게 스캔한다.'],
        script: '"문제를 풀고 나면 반드시 식의 맨 아랫줄 오른쪽 상자에 최종 기약분수를 적고 동그라미를 치세요. 선생님이 지나가며 그 동그라미 안의 숫자만 볼 겁니다."',
        tip: '답이 어디 적혀 있는지 찾느라 교사의 작업 기억을 쓰지 않게 되어, 학급 전체의 오답 경향을 분석할 여유가 생깁니다.' },
      { id: 9, cat: 'ch3', name: '능동적 관찰', eng: 'Active Observation (ActiveObs)', tags: ['순회관찰', '데이터수집'],
        concept: '학생들이 독립 과제를 수행할 때 목적 없이 교실을 거니는 대신, 모범 답안과 기록판(Tracker)을 들고 구체적인 관찰 초점에 따라 정오답 데이터를 수집하고 피드백하는 기법입니다.',
        steps: ['순회 바퀴(Lap)마다 관찰 초점을 정한다 (1바퀴: 식 세우기 확인, 2바퀴: 계산 정확성 확인).', '클립보드 기록지에 학생별 성취도나 오류 유형별 발생 빈도를 체크(Tally)한다.', '전체 토론 때 공유할 만한 훌륭한 답안이나 의미 있는 오답을 미리 점찍어 둔다(Hunting).'],
        script: '"지금부터 1차 순회를 돕니다. 첫 번째 순회에서는 여러분이 비례식의 외항과 내항을 바르게 세웠는지만 집중해서 보겠습니다."',
        tip: '때로는 개별 피드백을 줄이고 조용히 데이터를 수집하는 데 집중한 뒤, 가장 많이 틀린 지점을 학급 전체에 재지도하는 것이 훨씬 효율적입니다.' },
      { id: 10, cat: 'ch3', name: '보여주기', eng: 'Show Me', tags: ['전원참여', '즉각점검'],
        concept: '교사의 신호에 맞춰 모든 학생이 동시에 미니 화이트보드나 손가락 번호로 자신의 객관적 답안을 들어 올려, 교사가 한눈에 학급 전체의 이해도를 파악하는 기법입니다.',
        steps: ['객관식 답안 번호를 손가락 개수로 준비하거나 화이트보드에 답을 적게 한다.', '친구의 답을 보고 따라 하지 못하도록 반드시 "하나, 둘, 셋!" 신호에 맞춰 동시에 들게 한다.', '교사는 정답을 바로 말하지 않고 오답 분포를 확인한 뒤 이유를 질문한다.'],
        script: '"보드를 가슴 앞에 뒤집어 안으세요. 선생님 신호에 맞춰 동시에 듭니다. 하나, 둘, 셋, 보여주세요(Show Me)! 턱 높이로 반듯하게 듭니다."',
        tip: '답이 1번과 3번으로 팽팽히 갈렸을 때 정답을 바로 알려주지 말고, "옆 짝과 왜 다른 선택을 했는지 30초간 설득해 보세요"라고 연결하면 최고조의 몰입이 일어납니다.' },
      { id: 11, cat: 'ch3', name: '긍정적 확인', eng: 'Affirmative Checking', tags: ['개별화지도', '오류차단'],
        concept: '학생들이 독립 연습 문제로 넘어가거나 다음 단계로 진입하기 전, 반드시 교사로부터 현재 단계의 정답 확인(승인 사인)을 받아야만 다음 문제를 풀 수 있게 관문을 두는 기법입니다.',
        steps: ['과제 중간에 핵심 체크포인트 문항을 지정한다.', '해당 문항을 다 푼 학생은 정해진 신호(손을 머리에 얹기 등)를 보내 확인을 요청한다.', '교사가 빠르게 체크 표시를 해주면 그때 심화 과제로 넘어간다.'],
        script: '"2번 문제까지 다 푼 친구는 연필을 내려놓고 왼손을 들어 신호하세요. 선생님에게 통과 체크를 받은 사람만 3번 심화 문제로 넘어갈 수 있습니다."',
        tip: '잘못된 방법대로 10문제를 끝까지 다 풀고 나서 좌절하는 일을 예방해 줍니다.' },
      { id: 12, cat: 'ch3', name: '오류의 문화', eng: 'Culture of Error', tags: ['심리적안전감', '교실문화'],
        concept: '실수와 오답을 감추어야 할 부끄러운 일이 아니라, 우리 모두가 더 깊이 배우기 위해 반드시 거쳐야 하는 자연스럽고 가치 있는 과정으로 환영하는 교실 문화를 만드는 기법입니다.',
        steps: ['오답이 나와도 표정이나 말투에 실망감을 드러내지 않고 감정적 평정심을 유지한다.', '정답 여부를 즉시 알려주지 않고(정답 보류) 다양한 풀이의 타당성을 함께 검토한다.', '어려운 실수를 기꺼이 공유해 준 학생의 용기를 학급 전체 앞에서 인정하고 칭찬한다.'],
        script: '"지훈이가 정말 중요한 오답을 말해줬어요! 사실 이 함정은 이 단원을 처음 배울 때 가장 많이 빠지는 핵심 포인트예요. 지훈이 덕분에 우리 반 전체가 큰 공부를 하게 됐네요. 어디서 생각이 갈렸는지 같이 볼까요?"',
        tip: '학생이 정답을 맞혔을 때만 환하게 웃고 오답일 때 굳어지는 교사의 미세한 표정(Tell)을 관리해야 학생들이 교사의 눈치를 보지 않고 소신껏 답을 말합니다.' },
      { id: 13, cat: 'ch3', name: '쇼 콜', eng: 'Show Call', tags: ['시각적피드백', '작품분석'],
        concept: '순회 관찰 중에 발견한 학생의 실제 답안지나 공책을 실물화상기로 화면에 크게 띄워, 학급 전체가 함께 강점을 배우고 개선점을 찾아보게 하는 기법입니다.',
        steps: ['순회 중 모범 사례 또는 전형적인 "거의 다 맞은(Almost There)" 답안을 선정한다.', '실물화상기로 화면에 공유한다.', '교사가 일방적으로 첨삭하지 않고 학생들에게 "어디가 훌륭한가?", "무엇을 고치면 완벽해질까?"를 발문한다.'],
        script: '"지금 화면에 띄운 하은이의 문장을 다 같이 봅시다. 첫 문장에서 핵심 주장을 아주 명확하게 제시했어요. 자, 여기서 두 번째 문장을 어떻게 다듬으면 주장이 더 강력해질까요?"',
        tip: '오답 사례를 띄울 때는 학생이 공격받는다는 느낌을 받지 않도록 평소 "우리는 서로의 글을 함께 다듬어주는 동료"라는 오류의 문화가 선행되어야 합니다.' },
      { id: 14, cat: 'ch3', name: '자기 수정과 추적', eng: 'Own and Track', tags: ['메타인지', '오답노트'],
        concept: '문제를 함께 풀이한 뒤 학생들이 정답만 대충 고쳐 적고 끝내지 않도록, 다른 색깔 펜을 사용해 자신이 맞힌 것과 고친 과정, 핵심 근거를 스스로 공책에 기록(추적)하게 하는 기법입니다.',
        steps: ['정답 확인 시간에는 연필을 내려놓고 지정된 색펜(예: 초록색, 파란색)만 들게 한다.', '맞은 문항은 체크, 틀린 문항은 원래 풀이를 지우지 않은 채 옆에 바른 풀이 과정을 적게 한다.', '우수한 동료의 아이디어가 나오면 자신의 공책 여백에 추가 필기하게 한다.'],
        script: '"파란 펜을 드세요. 지우개로 원래 여러분이 썼던 답을 지우지 마세요! 원래 생각 옆에 파란 펜으로 왜 그렇게 고쳐야 하는지 화살표를 그어 수정 과정을 남깁니다."',
        tip: '틀렸던 흔적과 올바른 수정본이 나란히 남아 있어야 나중에 복습할 때 자신이 무엇을 몰랐었는지 정확히 메타인지를 발휘할 수 있습니다.' },

      // Ch 4. 학문적 분위기 (15~19)
      { id: 15, cat: 'ch4', name: '포기는 없다', eng: 'No Opt Out', tags: ['책무성', '성공경험'],
        concept: '질문을 받은 학생이 "모르겠어요"라며 대답을 회피할 때 그냥 다른 학생에게 넘어가지 않고, 힌트를 주거나 친구의 도움을 거쳐 결국 그 학생 자신의 입으로 정답을 말하게 하여 성공으로 마무리하는 기법입니다.',
        steps: ['학생이 "몰라요"라고 하면 다른 학생에게 정답이나 단서를 묻는다.', '다시 원래 학생에게 돌아와 방금 들은 정답을 자신의 목소리로 온전히 말하게 한다.', '또는 교사가 단서 질문을 던져 스스로 답을 찾게 한 뒤 격려하며 마무리한다.'],
        script: '학생 A: "모르겠어요."\n교사: "도윤아, 광합성이 일어나는 세포 소기관이 어디인지 알려줄래?"\n도윤: "엽록체입니다."\n교사: "고마워. 자, 다시 현수야, 광합성이 어디서 일어난다고?"\n학생 A: "엽록체요."\n교사: "정확해! 잘 기억해 두자."',
        tip: '"모른다"는 말이 수업 참여를 면제받는 티켓이 되지 않게 하되, 어조는 추궁이 아닌 따뜻한 지지여야 합니다.' },
      { id: 16, cat: 'ch4', name: '정답은 완전한 정답이어야 한다', eng: 'Right Is Right', tags: ['높은기대치', '정확성'],
        concept: '학생이 어설프게 맞거나 70~80% 수준의 불완전한 답을 말했을 때, 교사가 "그치, 이런 뜻이지?"라며 대신 포장해 주지 않고 학생 스스로 100% 정확한 정답에 도달할 때까지 기준을 지키는 기법입니다.',
        steps: ['학생의 부분적 정답에 대해 긍정적으로 인정하되, 아직 완성되지 않았음을 명확히 알린다.', '빠진 조건이나 정확한 교과 용어를 사용하도록 재발문한다.', '교사가 학생의 말을 가로채서 완성해 주려는 유혹을 참는다.'],
        script: '학생: "이순신 장군이 배를 만들어서 이겼어요."\n교사: "맞아, 배의 역할이 컸지. 하지만 우리가 배운 역사 용어를 넣어서, 어떤 전술과 어떤 배를 활용해 어느 해전에서 승리했는지 정확하게 다시 말해볼까?"',
        tip: '어정쩡한 답을 정답으로 인정해 버리면 학생들은 더 정밀하게 사고할 필요성을 느끼지 못합니다.' },
      { id: 17, cat: 'ch4', name: '사고 확장하기', eng: 'Stretch It', tags: ['심화발문', '고차원사고'],
        concept: '학생이 정답을 맞혔을 때 단순히 "잘했어" 하고 끝내지 않고, 후속 질문을 던져 지식을 더 깊게 파고들거나 새로운 상황에 적용해 보도록 사고를 확장하는 기법입니다.',
        steps: ['정답을 확인한 즉시 "왜 그렇게 생각했니?", "근거는 어디에 있니?"를 묻는다.', '더 수준 높은 어휘로 바꾸어 표현하게 하거나 반대 상황을 가정해 질문한다.', '또 다른 풀이 방법이 있는지 탐색하게 한다.'],
        script: '"정답입니다! 완벽해요. 자, 그렇다면 한 단계 더 나아가 볼까요? 만약 이 문제에서 분모가 0이 아닌 음수로 바뀐다면 부등호의 방향은 어떻게 달라질지 설명해 볼 수 있겠어요?"',
        tip: '정답에 대한 최고의 보상은 "질문 끝"이 아니라 "더 흥미롭고 도전적인 다음 질문"이라는 문화를 만듭니다.' },
      { id: 18, cat: 'ch4', name: '형식이 내용을 만든다', eng: 'Format Matters', tags: ['완전한문장', '발표태도'],
        concept: '학생들이 발표하거나 글을 쓸 때 학문적 표준에 맞는 문법, 주어와 서술어를 갖춘 완전한 문장, 그리고 교실 전체의 친구들이 모두 들을 수 있는 또렷한 목소리 크기를 요구하는 기법입니다.',
        steps: ['단어 하나로 툭 던지는 대답에는 "완전한 문장으로 말해볼까?"라고 부드럽게 요청한다.', '목소리가 작아 들리지 않으면 "교실 끝 친구에게도 들리도록 당당하게!"라고 신호를 준다.', '문법적 오류가 있으면 바른 표현을 짚어주어 다시 말하게 한다.'],
        script: '학생: "(작은 소리로) 42요."\n교사: "벽을 보고 말하면 벽은 관심이 없단다~ 친구들을 바라보고, 무엇이 왜 42인지 당당한 목소리와 완전한 문장으로 다시 들려줄래?"',
        tip: '짧은 암기 확인(Call and Response)에서는 단답형을 허용하되, 사고력을 요하는 질문에서는 반드시 완전한 문장으로 말하게 해야 논리력이 자랍니다.' },
      { id: 19, cat: 'ch4', name: '변명 없는 가르침', eng: 'Without Apology', tags: ['교사태도', '높은기대치'],
        concept: '학습 내용이 어렵거나 지루할 것이라고 교사가 지레짐작하여 학생들에게 미안해하거나 수준을 낮추지 않고, 배움의 본질적 가치와 학생들의 잠재력을 당당하게 믿고 가르치는 태도입니다.',
        steps: ['"이 부분은 좀 재미없는데 시험에 나오니까 참고 해" 같은 변명을 절대 하지 않는다.', '"너희에겐 좀 어렵겠지만"이라며 학생의 능력을 낮잡아 보지 않는다.', '어려운 과제일수록 "이걸 해내면 정말 짜릿할 거야"라며 도전을 격려한다.'],
        script: '❌ "오늘 배울 문법은 진짜 골치 아프고 지루한데 어쩔 수 없이 해야 해."\n⭕ "오늘 배울 내용은 문장의 구조를 꿰뚫어 보는 아주 정교하고 멋진 퍼즐입니다. 함께 풀어봅시다!"',
        tip: '교사가 교재를 대하는 태도가 곧 학생들이 그 학문을 대하는 태도가 됩니다.' },

      // Ch 5. 수업 구조 (20~26)
      { id: 20, cat: 'ch5', name: '도입 즉시 과제', eng: 'Do Now', tags: ['수업시작', '루틴'],
        concept: '학생들이 교실 문을 열고 들어오자마자 교사의 지시나 설명이 없어도 즉시 자리에 앉아 스스로 풀기 시작할 수 있도록 책상이나 칠판에 미리 준비해 둔 3~5분 분량의 짧은 과제입니다.',
        steps: ['교사의 설명 없이 학생 혼자 힘으로 풀 수 있는 명확한 과제(전 차시 복습 또는 오늘 수업 예열)를 준비한다.', '칠판이나 학습지의 항상 똑같은 위치에 제시한다.', '연필을 잡고 쓰도록 서면 과제로 부여하며 시간은 3~5분으로 엄격히 제한한다.'],
        script: '(교실 문 앞 맞이 시)\n"좋은 아침! 자리에 앉자마자 학습지 1쪽 상단의 Do Now 3문제를 조용히 풀기 시작합니다. 타이머는 이미 돌아가고 있어요."',
        tip: 'Do Now가 실패하는 가장 큰 이유는 교사가 설명을 덧붙여야만 풀 수 있는 어려운 문제를 내기 때문입니다. 100% 독립적으로 착수 가능해야 합니다.' },
      { id: 21, cat: 'ch5', name: '단계 밟아가기', eng: 'Take the Steps', tags: ['인지부하관리', '스캐폴딩'],
        concept: '복잡한 개념이나 문제를 한꺼번에 던져주지 않고, 작업 기억이 감당할 수 있는 작은 단계(Steps)로 쪼개어 명시적으로 시범을 보인 뒤 연습과 함께 안내를 점진적으로 줄여나가는(Guidance Fading) 기법입니다.',
        steps: ['초보 학습자를 위해 문제 해결 과정을 명확한 단계로 나누어 교사가 먼저 시범(Modeling)을 보인다.', '완성된 예시 답안(Worked Examples)을 함께 분석하며 각 단계의 이유를 확인한다.', '단계별로 짧게 끊어 연습시킨 후, 숙달되면 점차 교사의 힌트를 걷어낸다.'],
        script: '"방정식을 한 번에 풀려 하지 마세요. 먼저 1단계로 양변의 괄호를 푸는 것까지만 해봅시다. 선생님 칠판 풀이를 보고 여러분 문제의 1단계만 완성해 보세요."',
        tip: '초보자에게 추상적인 루브릭(채점 기준표)을 주는 것보다, 잘된 실제 예시 답안과 잘못된 예시 답안을 나란히 비교해 보여주는 것이 훨씬 효과적입니다.' },
      { id: 22, cat: 'ch5', name: '칠판과 공책의 일치', eng: 'Board = Paper', tags: ['필기지도', '구조화'],
        concept: '학생들이 핵심 내용을 체계적으로 기록하고 요약하는 법을 배울 수 있도록, 교사의 칠판 판서(또는 화면의 학습지 투사본)와 학생의 공책 필기 형태를 똑같이 일치시키는 기법입니다.',
        steps: ['교사가 실물화상기나 칠판에 학생 학습지와 똑같은 양식을 띄우고 함께 필기하며 시범을 보인다.', '어디에 밑줄을 긋고 어디에 여백 메모를 남길지 구체적으로 보여준다.', '학년과 숙련도가 올라감에 따라 점차 스스로 필기 노트를 구조화하도록 자율성을 넓힌다.'],
        script: '"선생님이 화면의 빈칸에 핵심 키워드를 적고 화살표로 연결한 것처럼, 여러분의 학습지 똑같은 위치에 그대로 기록하세요."',
        tip: '필기하는 법도 배워야 할 중요한 기술입니다. 초기에는 칠판이 곧 내 공책의 거울이 되도록 안내해 주어야 합니다.' },
      { id: 23, cat: 'ch5', name: '책임감 있는 독립 읽기', eng: 'Accountable Independent Reading', tags: ['독해력', '묵독'],
        concept: '학생들이 눈으로만 글자를 훑고 지나가지 않도록, 조용히 혼자 글을 읽는 동안 명확한 주석 달기(Annotation)나 초점 질문을 부여하여 능동적으로 의미를 파악하며 읽게 하는 기법입니다.',
        steps: ['한 번에 읽을 분량을 적정하게 끊어 제시한다.', '읽기 전에 "무엇을 찾아 밑줄 그을 것인가"라는 명확한 읽기 목적(과제)을 부여한다.', '학생들이 읽는 동안 순회하며 책 여백에 표시된 밑줄과 메모를 보고 독해 수준을 점검한다.'],
        script: '"지금부터 42쪽 두 번째 문단까지 각자 눈으로 읽습니다. 읽으면서 주인공이 두려움을 느끼고 있다는 증거가 되는 문장 두 개를 찾아 별표 하세요."',
        tip: '읽기를 시작하기 전, "우리가 읽으면서 무엇을 찾아 표시해야 하지?"라고 표적 발문을 던져 과제를 명확히 인지했는지 확인하세요.' },
      { id: 24, cat: 'ch5', name: '유창한 낭독', eng: 'FASE Reading', tags: ['읽기유창성', '몰입'],
        concept: '감정을 살린 유창한 읽기(Fluent), 전원이 눈으로 따라 읽는 책임감(Accountable), 예측 불가능하고 짧은 호흡의 전환(Staccato), 교사의 생생한 시범이 어우러진 학급 전체 소리 내어 읽기 기법입니다.',
        steps: ['교사가 먼저 감정을 살려 낭독하며 글의 분위기와 유창성의 기준을 잡아준다.', '한 학생이 너무 길게 읽지 않도록 몇 문장 단위로 끊어 "다음, 지민이!"처럼 빠르게 다음 독자를 호명한다.', '모든 학생이 손가락이나 연필로 읽는 위치를 짚으며(Tracking) 따라오게 한다.'],
        script: '"(교사가 생생하게 읽다가) ...그 순간 문이 삐걱 열렸습니다. 자, 수빈이 이어서!" (수빈이 두 문장 읽음) "좋아, 바로 태현이!"',
        tip: '누가 언제 호명될지 모르기 때문에 학급 전원이 텍스트에서 눈을 떼지 못하고 이야기 속으로 빨려 들어갑니다.' },
      { id: 25, cat: 'ch5', name: '교실 순회', eng: 'Circulate', tags: ['교실장악', '동선관리'],
        concept: '교사가 교탁 앞에만 머물지 않고 수업 시작 5분 이내에 책상 사이의 보이지 않는 장벽을 넘어 교실 구석구석을 자연스럽게 이동하며 모든 학생의 학습을 가까이서 살피는 기법입니다.',
        steps: ['교실 통로를 막는 가방이나 장애물을 미리 정리해 어디든 걸어갈 수 있게 한다.', '특정 학생에게 조언을 할 때도 교실 전체가 시야에 들어오도록 바깥쪽에서 안쪽을 바라보며 선다(Position for Power).', '교실의 네 모서리와 뒷자리까지 고르게 발걸음이 닿도록 동선을 짠다.'],
        script: '(교사가 교실 뒤편에 서서 앞쪽을 바라보며 발표를 듣거나, 자연스럽게 통로를 걸으며 학생들의 공책을 눈으로 스캔함)',
        tip: '한 학생의 책상을 봐주느라 교실 전체에 등을 돌리고 서 있으면 반대편 교실 상황이 사각지대에 놓이게 됩니다. 늘 교실 전체를 마주 보는 각도로 서세요.' },
      { id: 26, cat: 'ch5', name: '수업 확인권', eng: 'Exit Ticket', tags: ['형성평가', '수업마무리'],
        concept: '수업이 끝나기 직전 3~5분 동안 오늘 배운 핵심 목표를 달성했는지 확인하는 1~3개의 짧은 문제를 풀고 제출하게 하여, 다음 차시 수업 준비의 객관적 데이터로 삼는 기법입니다.',
        steps: ['수업 목표의 핵심을 정확히 측정하는 1~3문항(객관식과 서술형 혼합)을 간결하게 구성한다.', '학생들이 혼자 힘으로 조용히 풀게 하여 순수한 성취도를 확인한다.', '수거 후 즉시 상·중·하 또는 오류 유형별로 분류하여 내일 수업의 도입 복습 계획에 반영한다.'],
        script: '"오늘 배운 분수의 나눗셈 원리를 잘 이해했는지 확인권 2문제를 풀어봅시다. 3분 동안 조용히 풀고, 다 푼 사람은 뒤집어 놓으세요."',
        tip: '수업 확인권을 걷어서 책상 서랍에 쌓아두기만 하면 의미가 없습니다. 확인권 분석이 곧 내일 수업 준비의 첫걸음입니다.' },

      // Ch 6. 속도 조절 (27~31)
      { id: 27, cat: 'ch6', name: '호흡 전환하기', eng: 'Change the Pace', tags: ['수업리듬', '몰입'],
        concept: '수업 시간 동안 한 가지 활동만 길게 지속하여 지루해지지 않도록, 생각하고 글 쓰는 정적인 활동과 짝 대화나 발표 같은 역동적인 활동의 리듬을 의도적으로 교차시키는 기법입니다.',
        steps: ['동일한 학습 목표 안에서도 활동의 유형(글쓰기 → 짝 토론 → 전체 발표 → 개별 연습)을 5~10분 주기로 전환한다.', '깊은 숙고가 필요할 때는 호흡을 늦추고, 단순 복습이나 확인 때는 템포를 빠르게 당긴다.', '학생들의 주의력이 떨어지기 직전에 활동 방식을 바꿔 새로운 활력을 불어넣는다.'],
        script: '"지금까지 5분 동안 아주 진지하게 각자 글을 썼습니다. 이제 펜을 내려놓고, 짝을 향해 돌아앉아 45초 동안 내가 쓴 핵심 문장을 빠르게 들려주세요. 시작!"',
        tip: '내용(주제)을 자꾸 바꾸는 것이 아니라, 같은 주제를 다루는 "참여 활동의 형태"를 바꾸어 호흡에 완급을 주는 것입니다.' },
      { id: 28, cat: 'ch6', name: '경계선 선명하게 하기', eng: 'Brighten the Lines', tags: ['활동전환', '주의집중'],
        concept: '한 활동이 끝나고 다음 활동이 시작되는 전환 지점(경계선)을 모호하게 흘려보내지 않고, 명확한 시작 신호(In-cue)와 종료 신호(Out-cue)로 칼같이 구분하여 몰입도를 높이는 기법입니다.',
        steps: ['활동을 시작할 때 "시간은 2분입니다. 준비, 시작!"처럼 명확한 출발 신호를 준다.', '종료 시에도 "3, 2, 1, 연필 내려놓고 시선은 선생님!"처럼 일제히 멈추는 신호를 사용한다.', '학생들이 스르르 대화를 시작하는 대신 신호와 동시에 일제히 활동에 돌입하게 만든다.'],
        script: '"짝과 함께 두 인물의 공통점을 찾아보세요. 시간은 1분입니다. 짝을 바라보고... 시작(Go)!"\n(1분 후) "3, 2, 1, 대화 멈추고 시선은 앞을 봅니다."',
        tip: '활동의 시작과 끝이 선명하면 옆 친구들도 모두 즉시 시작하는 것이 눈에 보여 주저하던 학생도 지체 없이 참여하게 됩니다.' },
      { id: 29, cat: 'ch6', name: '모두 손 내리기', eng: 'All Hands', tags: ['발문관리', '사고시간'],
        concept: '교사가 질문을 던지는 순간 성급하게 손을 드는 학생들을 제지하거나, 한 학생이 발표하는 동안 다른 학생들이 계속 손을 들고 흔드는 것을 내리게 하여 모두가 경청과 사고에 집중하게 하는 기법입니다.',
        steps: ['질문 직후 "아직 손들지 마세요. 모두 깊이 생각하는 시간입니다"라고 안내한다.', '발표자가 정해지면 나머지 학생들에게 "모두 손 내리고 친구의 말에 집중하세요"라고 손짓으로 신호한다.', '특정 구간에서는 손들기 없이 콜드 콜이나 짝 대화로만 진행함을 미리 알린다.'],
        script: '"잠깐, 모두 손을 내려주세요. 다른 친구들이 조급해하지 않고 충분히 생각할 수 있도록 10초 동안은 아무도 손을 들지 않고 머릿속으로만 답을 정리합니다."',
        tip: '누군가 발표하고 있는데 다른 아이들이 손을 번쩍 들고 있으면, 그 아이들은 친구의 말을 듣는 것이 아니라 자기 할 말만 생각하고 있는 상태입니다.' },
      { id: 30, cat: 'ch6', name: '타이머 활용하기', eng: 'Work the Clock', tags: ['시간관리', '집중력'],
        concept: '과제를 부여할 때 시간을 구체적인 숫자로 명시하고 타이머나 카운트다운을 활용해 시간의 가치를 가시화함으로써, 학생들이 미적거리지 않고 즉시 과제에 몰입하게 만드는 기법입니다.',
        steps: ['"잠깐 동안 해보세요" 대신 "2분 30초 드립니다"처럼 약간 구체적이고 타이트한 시간을 제시한다.', '칠판 화면에 타이머를 띄우거나 중간중간 남은 시간을 알려주며 페이스를 조절한다.', '단순 전환 동작은 "5, 4, 3, 2, 1" 카운트다운으로 신속하게 마무리한다.'],
        script: '"지금부터 3문제를 푸는 데 정확히 3분 드립니다. 벌써 1번 문제를 풀기 시작한 친구들이 보이네요! 타이머 시작합니다."',
        tip: '카운트다운을 할 때 "3초 안에 공책 안 펴면 혼난다"가 아니라, "벌써 첫 줄은 다 준비가 끝났네요, 3, 2, 1, 완벽합니다!"처럼 긍정적으로 독려하세요.' },
      { id: 31, cat: 'ch6', name: '1분 1초의 소중함', eng: 'Every Minute Matters', tags: ['자투리시간', '인출연습'],
        concept: '수업이 2~3분 일찍 끝났거나 복도에서 줄 서서 대기하는 짧은 자투리 시간을 버리지 않고, 준비된 짧은 퀴즈나 어휘 복습으로 알차게 채워 배움의 밀도를 높이는 기법입니다.',
        steps: ['언제든 꺼내 쓸 수 있는 1분짜리 구두 복습 질문(핵심 어휘, 구구단, 역사 연도 등)을 머릿속에 준비해 둔다.', '종이 울리기 전 2분이 남았을 때 "자, 남은 시간은 쉬자" 대신 빠른 스피드 퀴즈를 진행한다.', '우리 교실의 시간은 1분도 허투루 쓰지 않는다는 학구적 자부심을 심어준다.'],
        script: '"수업 종이 울리기까지 딱 90초 남았습니다! 가방 싸지 말고, 오늘 배운 사자성어 스피드 퀴즈 3문제 갑니다. 첫 번째 문제 맞힐 사람!"',
        tip: '하루에 버려지는 3분을 모으면 1년이면 수십 시간의 수업 시수가 됩니다.' },

      // Ch 7. 발문 참여 비율 (32~37)
      { id: 32, cat: 'ch7', name: '발문의 기본 원칙', eng: 'Phrasing Fundamentals', tags: ['발문설계', '명료성'],
        concept: '질문이 모호하거나 한 번에 여러 가지를 물어 학생의 작업 기억을 혼란스럽게 하지 않도록, 질문을 간결하고 명확하며 한 번에 하나씩 던지는 발문의 기본 수칙입니다.',
        steps: ['핵심 발문은 즉흥적으로 만들지 않고 수업 준비 단계에서 문장을 미리 다듬어 적어둔다.', '한 질문 안에 두세 개의 질문이 섞인 복합 발문은 하나씩 쪼개어 묻는다.', '질문을 던진 뒤 교사가 부연 설명을 계속 덧붙여 학생의 사고를 방해하지 않는다.'],
        script: '❌ "주인공은 왜 고향을 떠났고, 거기서 누구를 만났으며, 그 일을 겪고 나서 성격이 어떻게 변했니?"\n⭕ "먼저 첫 번째 질문입니다. 주인공이 고향을 떠나기로 결심한 결정적인 사건은 무엇이었나요?"',
        tip: '질문을 던진 후 교사가 불안해서 말을 자꾸 덧붙이면 학생들은 처음 질문을 잊어버리고 혼란에 빠집니다. 간결하게 묻고 입을 다무세요.' },
      { id: 33, cat: 'ch7', name: '생각할 시간', eng: 'Wait Time', tags: ['사고력', '발문'],
        concept: '교사가 질문을 던진 뒤 첫 번째 학생을 지목하기 전까지 최소 3~5초 이상 의도적인 침묵의 시간을 확보하여, 모든 학생이 깊이 있는 답변을 구상할 수 있게 돕는 기법입니다.',
        steps: ['질문을 던진 후 바로 이름을 부르지 않고 최소 3~5초간 조용히 교실을 둘러본다.', '기다리는 시간 동안 "본문 3문단에서 단서를 찾아보세요", "공책에 키워드를 적어보세요"라며 구체적인 사고 행동을 안내(Prompting)한다.', '충분한 시간이 흐른 뒤 손을 든 학생이나 콜드 콜로 답변을 듣는다.'],
        script: '"이 실험에서 대조군을 설정한 이유는 무엇일까요? 바로 대답하지 마세요. 10초 동안 실험 표를 다시 보면서 머릿속으로 문장을 정리해 보세요... (침묵 유지) ...자, अब 지민이가 말해볼까요?"',
        tip: '대부분의 교사는 질문 후 평균 1초도 기다리지 못하고 말을 이어갑니다. 마음속으로 천천히 "일초, 이초, 삼초, 사초"를 세는 연습이 필요합니다.' },
      { id: 34, cat: 'ch7', name: '무작위 지목', eng: 'Cold Call', tags: ['전원참여', '발언형평성'],
        concept: '손을 든 학생만 지목하는 대신, 손을 들지 않은 학생이라도 교사가 따뜻한 미소와 함께 이름을 불러 대화에 초대함으로써 모든 학생이 질문에 대해 능동적으로 생각하게 만드는 기법입니다.',
        steps: ['반드시 "질문을 먼저 던지고 -> 생각할 시간을 준 뒤 -> 학생 이름을 호명"하는 순서를 지킨다(Timing the Name).', '딴짓하는 학생을 벌주기 위한 수단이 아니라, 모든 학생의 목소리를 고르게 듣기 위한 포용적 도구로 사용한다.', '호명할 때 따뜻한 미소와 기대감을 담아 긴장감을 낮춰준다.'],
        script: '"작가가 이 장면을 겨울 배경으로 설정한 이유는 무엇일까요? (3초간 기다리며 미소 지음) ...은우야, 은우 생각은 어떠니?"',
        tip: '이름을 먼저 부르고("은우야,") 질문을 던지면 나머지 29명의 학생들은 "나 안 걸렸다!"며 그 순간 생각을 멈춰버립니다. 무조건 질문이 먼저입니다.' },
      { id: 35, cat: 'ch7', name: '일제 응답', eng: 'Call and Response', tags: ['에너지', '기초복습'],
        concept: '단답형 핵심 지식이나 어휘를 확인할 때, 교사의 명확한 신호에 맞춰 학급 전원이 한목소리로 힘차게 정답을 외치게 하여 교실의 활력과 인출 효과를 높이는 기법입니다.',
        steps: ['정답이 하나로 명확히 떨어지는 짧은 사실 확인 질문을 던진다.', '일제 응답임을 알리는 약속된 신호(손짓, "다 같이!", "하나, 둘, 셋!")를 사용한다.', '일부만 웅얼거리지 않고 전원이 또렷하게 답하도록 연습시킨다.'],
        script: '"삼각형의 세 내각의 합은 몇 도인가요? 잠깐, 선생님 손짓에 맞춰 다 같이 외칩니다. 하나, 둘, 셋!" -> (학생 전원) "180도!"',
        tip: '콜드 콜과 일제 응답을 적절히 섞어 쓰면 교실의 리듬감이 살아나고 학생들의 졸음이 싹 가십니다.' },
      { id: 36, cat: 'ch7', name: '참여 방식 명시하기', eng: 'Means of Participation', tags: ['수업규칙', '질서'],
        concept: '교사가 질문을 던질 때 학생들이 어떤 방식으로 답해야 하는지(손들기, 짝 대화, 글로 쓰기, 일제 응답, 콜드 콜 등)를 사전에 명확히 알려주어 불필요한 자리 이탈 발언(Call-outs)을 막는 기법입니다.',
        steps: ['질문하기 직전이나 직후에 원하는 응답 방식을 분명히 선언한다.', '"손을 들고 대답해 볼 사람?", "공책에 먼저 적어보세요"처럼 행동 지침을 함께 준다.', '약속된 방식을 어기고 불쑥 소리를 지르는 경우 정중하게 제지하고 원칙을 지킨다.'],
        script: '"다음 질문은 손을 들거나 소리 내어 말하지 않고, 먼저 각자 빈칸에 답을 적는 질문입니다. 다 적은 뒤 선생님이 무작위로 호명하겠습니다."',
        tip: '참여 방식을 명시하지 않으면 목소리 큰 서너 명의 학생이 교실의 모든 질문을 독점하게 됩니다.' },
      { id: 37, cat: 'ch7', name: '질문 쪼개기', eng: 'Break It Down', tags: ['스캐폴딩', '오답대응'],
        concept: '학생이 질문에 답하지 못하거나 틀렸을 때 교사가 곧바로 정답을 알려주지 않고, 학생이 아는 지점까지 질문을 한 단계 낮추어 단서를 제공함으로써 스스로 정답을 찾아내게 돕는 기법입니다.',
        steps: ['오답의 원인이 된 핵심 고리가 무엇인지 파악한다.', '최소한의 힌트(문맥 제시, 규칙 상기, 잘못된 부분 짚어주기, 두 가지 보기 중 선택하게 하기)를 담은 하위 질문을 던진다.', '학생이 그 단서를 딛고 원래 질문의 답에 도달하면 칭찬한다.'],
        script: '학생: "(colonial의 뜻을 몰라 머뭇거림)"\n교사: "우리가 지난 시간에 배웠던 colony라는 명사 기억나니? 무슨 뜻이었지?"\n학생: "식민지요!"\n교사: "맞아! 그럼 거기에 형용사를 만드는 -al이 붙은 colonial은 무슨 뜻이 될까?"\n학생: "식민지의!"',
        tip: '너무 많은 힌트를 한꺼번에 주기보다, 학생이 스스로 생각할 여지를 남기는 "가장 작은 힌트"부터 단계적으로 제시하세요.' },

      // Ch 8. 글쓰기 참여 비율 (38~42)
      { id: 38, cat: 'ch8', name: '모두 쓰기', eng: 'Everybody Writes', tags: ['사고력', '글쓰기'],
        concept: '중요하고 깊이 있는 질문을 다루기 전에 모든 학생이 자신의 생각을 짧게 글로 먼저 적어보게 함으로써, 전원이 깊은 사고를 거치고 글쓰기를 통해 새로운 통찰을 발견하게 하는 기법입니다.',
        steps: ['토론 가치가 높은 핵심 발문을 제시한다.', '발표나 토론 전에 1~3분간 학습지의 지정된 공간에 자신의 초기 생각을 적게 한다.', '글을 쓰는 것을 "완성된 정답 제출"이 아니라 "생각을 발견하고 정리하는 과정"으로 안내한다.'],
        script: '"이 문제에 대해 바로 토론하기 전에, 각자 공책에 자신의 추측(Conjecture)과 이유를 두 문장으로 먼저 적어보세요. 틀려도 좋으니 글을 쓰면서 생각을 발전시켜 봅시다. 2분 드립니다."',
        tip: '"모두 쓰기"를 거친 뒤에는 평소 발표를 두려워하던 학생도 자신이 쓴 글을 보며 자신감 있게 발표할 수 있습니다.' },
      { id: 39, cat: 'ch8', name: '침묵의 개인 집중', eng: 'Silent Solo', tags: ['몰입', '글쓰기루틴'],
        concept: '학생들이 글을 쓰거나 문제를 푸는 독립 시간 동안 교실 안에 완벽한 침묵과 고요를 유지하여, 주의가 분산되지 않고 오롯이 깊은 사고와 글쓰기에만 몰입하도록 보호하는 기법입니다.',
        steps: ['글쓰기 시작 신호와 함께 "지금부터는 완벽한 침묵의 개인 집중(Silent Solo) 시간입니다"라고 선언한다.', '교사 자신도 불필요한 전체 방송 멘트를 삼가고 조용히 순회한다.', '시작 후 3초 이내에 모든 연필이 움직이며 고요한 집중 상태에 들어가도록 습관화한다.'],
        script: '"독서 노트 3번 질문입니다. 본문에서 근거를 찾아 완성된 문장으로 쓰세요. 3분간 Silent Solo! 시작!"',
        tip: '누군가 옆에서 소곤거리거나 교사가 계속 말을 걸면 학생의 작업 기억이 깨져 깊은 문장을 쓸 수 없습니다. 고요함은 학생들의 사고를 지켜주는 방패입니다.' },
      { id: 40, cat: 'ch8', name: '글쓰기 앞세우기', eng: 'Front the Writing', tags: ['토론준비', '작업기억'],
        concept: '"먼저 토론하고 나중에 정리 글쓰기"라는 통념을 뒤집어, 먼저 글을 써서 생각을 정리하게 한 뒤 토론을 진행하고, 토론 후 글을 수정하게 하는 수업 설계 기법입니다.',
        steps: ['텍스트를 읽은 직후 짧은 글쓰기 과제를 먼저 부여한다.', '학생들이 글을 쓰는 동안 교사는 순회하며 훌륭한 아이디어를 가진 학생들을 점찍어 둔다(Hunting).', '작성된 글을 바탕으로 수준 높은 토론을 벌인 뒤, 토론에서 얻은 통찰을 반영해 글을 보완하게 한다.'],
        script: '"먼저 2분 동안 작가의 의도에 대한 여러분의 생각을 글로 씁니다. 그다음 짝과 나눌 거니까 탄탄한 문장을 준비해 보세요."',
        tip: '자신이 할 말을 미리 종이에 적어두면, 토론할 때 "내 차례에 무슨 말을 하지?" 하고 불안해하느라 작업 기억을 쓰지 않고 친구의 발표를 여유 있게 경청할 수 있습니다.' },
      { id: 41, cat: 'ch8', name: '한 문장의 예술', eng: 'Art of the Sentence', tags: ['문장력', '복합적사고'],
        concept: '학생들에게 여러 줄로 길게 쓰라고 하는 대신, 복잡한 개념이나 내용을 정교한 구문 조건이 포함된 "단 하나의 완벽한 문장"으로 압축해 쓰도록 요구하는 기법입니다.',
        steps: ['요약하거나 분석할 주제를 제시하고 "단 한 문장으로 쓰세요"라고 제한한다.', '복합적인 사고를 유도하는 문장 시작 어구(예: "비록 ~일지라도,", "~의 결과로")나 문법 조건(동격어구 활용 등)을 지정해 준다.', '완성된 명문장들을 쇼 콜로 함께 감상하고 분석한다.'],
        script: '"주인공의 이중적인 성격을 설명하되, 반드시 \'비록 겉으로는 ~처럼 보이지만,\'이라는 표현으로 시작하는 단 하나의 문장으로 완성해 보세요."',
        tip: '새로운 문장 구조(구문)를 연습시키면, 그 문장 구조가 요구하는 논리적 관계(양보, 대조, 인과)에 맞춰 학생의 사고 수준 자체가 한 차원 높아집니다.' },
      { id: 42, cat: 'ch8', name: '규칙적인 퇴고', eng: 'Regular Revision', tags: ['글쓰기수정', '성장마인드셋'],
        concept: '글쓰기를 거창한 논술 시간에만 고쳐 쓰는 것이 아니라, 매일 수업 중 작성한 한두 문장의 짧은 답안이라도 토론 직후 더 나은 어휘와 논리로 즉시 고쳐 쓰게(Revision) 하는 기법입니다.',
        steps: ['초기 글쓰기와 학급 토론을 마친 뒤, 1~2분의 퇴고 시간을 반드시 부여한다.', '토론에서 나온 핵심 어휘나 친구의 좋은 근거를 추가해 원래 문장을 업그레이드하게 한다.', '초안과 수정본의 차이를 통해 자신의 생각이 어떻게 발전했는지 눈으로 확인하게 한다.'],
        script: '"방금 토론에서 나온 \'모순\'과 \'역설\'이라는 단어를 활용해서, 여러분이 처음에 적었던 문장을 한 단계 더 학술적인 문장으로 고쳐 써보세요."',
        tip: '수정은 "처음에 틀렸기 때문에 받는 벌"이 아니라 "좋은 생각을 걸작으로 다듬는 즐거운 과정"임을 일상적으로 경험하게 해줍니다.' },

      // Ch 9. 토론 참여 비율 (43~46)
      { id: 43, cat: 'ch9', name: '짝 대화', eng: 'Turn and Talk', tags: ['전원참여', '소통'],
        concept: '짧고 명확하게 구조화된 시간 동안 옆자리(어깨 짝) 또는 앞자리 짝과 질문에 대한 생각을 주고받게 하여 교실의 참여 비율과 에너지를 폭발적으로 높이는 기법입니다.',
        steps: ['평소 누가 누구의 짝인지, 누가 먼저 말할지(창가 쪽 먼저 등) 루틴을 명확히 정해둔다.', '대화가 가장 활발하게 무르익는 "파도의 정점(Crest of the Wave)"에서 종료 신호를 보내 잡담으로 흐르기 전에 마무리한다.', '짝 대화 직후 "짝이 해준 멋진 생각을 소개해 줄 사람?"이라며 경청 여부를 확인한다.'],
        script: '"어깨 짝을 보세요! 이번에는 복도 쪽 친구가 먼저 30초간 말하고, 창가 쪽 친구가 이어받습니다. 준비, 시작!"',
        tip: '대화가 완전히 끊겨 조용해질 때까지 기다렸다가 끝내면 수업의 탄력이 죽습니다. 아쉬울 만큼 대화가 절정에 달했을 때 회수하세요.' },
      { id: 44, cat: 'ch9', name: '토론의 습관', eng: 'Habits of Discussion', tags: ['경청', '상호작용'],
        concept: '학생들의 발언이 교사를 향한 개별 답변의 나열에 그치지 않고, 앞선 친구의 말을 경청하고 연결하며 진정한 상호 대화가 이루어지도록 구체적인 화법과 태도를 가르치는 기법입니다.',
        steps: ['발표할 때 교사만 쳐다보지 않고 교실의 친구들을 바라보며 말하게 한다.', '앞 친구의 말에 이어가는 연결 표현("지우의 생각에 덧붙여서...", "민수의 의견도 일리가 있지만 제 생각은...")을 명시적으로 가르치고 게시한다.', '친구 말에 동의하거나 공감할 때 고개를 끄덕이거나 무음 손짓 신호를 보내게 한다.'],
        script: '"하준이가 좋은 출발을 열어줬네요. 자, 하준이의 의견에 근거를 보태어 발전시켜 줄(Build on) 친구 있나요? 발표할 때는 선생님이 아니라 친구들을 바라보고 말해 주세요."',
        tip: '토론의 기술은 저절로 생기지 않습니다. 타인의 말을 존중하며 이어받는 문장 틀을 반복해서 연습시켜야 합니다.' },
      { id: 45, cat: 'ch9', name: '묶음 처리', eng: 'Batch Process', tags: ['학생주도', '토론심화'],
        concept: '학생 한 명이 말할 때마다 교사가 끼어들어 평가하고 요약하는 탁구식 대화를 멈추고, 3~4명의 학생이 연속으로 의견을 주고받을 때까지 교사의 개입을 보류하는 기법입니다.',
        steps: ['한 학생이 발표를 마치면 교사가 코멘트하지 않고 손짓이나 호명으로 바로 다음 학생에게 발언권을 넘긴다.', '학생들이 스스로 앞 사람의 의견에 찬성·반대·보완하며 대화를 엮어가게 한다.', '3~4명의 발언이 묶음(Batch)으로 오간 뒤에 교사가 핵심 논점을 한 번에 정리한다.'],
        script: '"지금부터는 선생님이 중간에 끼어들지 않겠습니다. 유진이가 먼저 의견을 말하고 나면, 손든 친구들 중 한 명을 유진이가 직접 지목해서 세 명이 연속으로 토론을 이어가 보세요."',
        tip: '교사가 매번 "맞아, 잘했어"라고 개입하면 학생들은 친구의 말을 듣지 않고 교사의 입만 쳐다보게 됩니다.' },
      { id: 46, cat: 'ch9', name: '절제된 토론', eng: 'Disciplined Discussion', tags: ['학술적토론', '근거중심'],
        concept: '토론이 산만하게 흩어지거나 근거 없는 주장만 난무하지 않도록, 핵심 주제에 집중하고 명확한 텍스트 근거와 완결된 논리를 갖추어 말하도록 이끄는 기법입니다.',
        steps: ['학생들이 막연한 추측을 말할 때 "본문 몇째 줄에서 그 근거를 찾았니?"라고 텍스트 근거를 요구한다.', '논점에서 벗어난 이야기가 나오면 정중하게 원래의 핵심 질문으로 방향을 되돌린다.', '토론의 결론이 나면 각자 정리된 생각을 한 문장으로 공책에 기록(Stamp)하며 매듭짓는다.'],
        script: '"흥미로운 상상이긴 하지만, 우리는 지금 본문의 사실에 근거해 추론하고 있어요. 주인공이 후회하고 있다는 증거를 본문 어휘에서 직접 찾아 말해볼까요?"',
        tip: '좋은 토론은 단순히 목소리가 크고 활발한 것이 아니라, 증거를 바탕으로 서로의 생각이 더 정교해지는 과정입니다.' },

      // Ch 10. 절차와 루틴 (47~51)
      { id: 47, cat: 'ch10', name: '문턱 넘기와 힘찬 시작', eng: 'Threshold and Strong Start', tags: ['수업시작', '관계형성'],
        concept: '교실 출입문(문턱)에서 학생 한 명 한 명을 따뜻하게 맞이하며 기대치를 환기하고, 교실에 들어선 순간부터 자리에 앉아 과제를 시작하기까지의 전 과정을 매끄러운 루틴으로 운영하는 기법입니다.',
        steps: ['교실 문 앞에 서서 교실 안과 복도를 동시에 볼 수 있는 각도로 학생들을 맞이한다.', '미소와 눈맞춤으로 반갑게 인사하며 "들어가자마자 Do Now 시작하자"라고 짧게 안내한다.', '외투 걸기, 자료 챙기기, 착석 후 즉시 연필 잡기까지 1분 안에 이루어지도록 절차를 정착시킨다.'],
        script: '"어서 와, 시우야! 어제 숙제 정말 꼼꼼히 잘했더라. 들어가서 바로 1번 문제부터 풀어보자!"',
        tip: '수업의 첫 2분이 그날 수업 40분 전체의 온도와 질서를 결정합니다.' },
      { id: 48, cat: 'ch10', name: '주의 집중의 습관', eng: 'Habits of Attention', tags: ['경청문화', '심리적안전감'],
        concept: '누군가 교실에서 말할 때 책상을 정리하고 바른 자세로 앉아 말하는 사람을 따뜻하게 바라보며(Tracking) 경청함으로써, 집중력을 높이고 발표자에게 지지를 보내는 공동체 습관입니다.',
        steps: ['집중 신호가 나오면 손에 든 물건을 내려놓고 바르게 앉아 화자를 바라보게 한다.', '친구가 발표할 때 시선을 돌려 바라보는 것은 "너의 생각은 우리에게 매우 중요해"라는 존중의 표현임을 가르친다.', '고개를 끄덕이는 등 긍정적인 비언어적 반응으로 발표자를 응원하게 한다.'],
        script: '"지금부터 서윤이가 자신의 풀이를 설명할 겁니다. 모두 연필을 내려놓고 서윤이를 바라보며 눈빛으로 응원해 줍시다."',
        tip: '주의 집중의 습관은 학생을 통제하려는 것이 아니라, 어떤 학생이 입을 열든 교실의 모든 친구가 귀 기울여 주는 안전한 공동체를 만드는 일입니다.' },
      { id: 49, cat: 'ch10', name: '효율적인 동선과 공학적 설계', eng: 'Engineer Efficiency', tags: ['시간절약', '교실운영'],
        concept: '유인물 배부, 자료 수거, 교구 정리, 줄 서기 등 매일 반복되는 물리적 이동과 절차를 가장 단순하고 빠른 동선으로 설계하여 수업 시간 손실을 최소화하는 기법입니다.',
        steps: ['교사가 돌아다니며 유인물을 나눠주는 대신, 맨 앞줄이나 분단 끝에서 옆으로 넘기는 고정된 전달 경로를 만든다.', '복잡한 절차를 1-2-3의 간단한 단계 구호로 압축한다.', '목표 시간을 정해두고 물 흐르듯 자동으로 이루어질 때까지 연습시킨다.'],
        script: '"학습지 수거합니다. 모두 왼쪽 끝 자리로 모으세요. 10초 안에 분단 맨 왼쪽 책상 위에 한 묶음으로 정렬됩니다. 시작!"',
        tip: '유인물을 나눠주고 걷는 데만 매 시간 3분씩 쓰면 1년이면 엄청난 수업 시간이 길거리에 버려집니다.' },
      { id: 50, cat: 'ch10', name: '루틴 구축하기', eng: 'Routine Building', tags: ['습관형성', '학급경영'],
        concept: '중요한 교실 절차를 단순히 "이렇게 해라"라고 말로만 설명하는 데 그치지 않고, 구체적인 시범과 반복 연습을 통해 생각하지 않아도 몸이 먼저 움직이는 자동화된 습관으로 정착시키는 기법입니다.',
        steps: ['왜 이 루틴이 필요한지 설명하고, 교사가 구체적인 동작으로 시범(Modeling)을 보인다.', '번호를 붙여 작은 단계로 나누어 전체 학생이 함께 연습(Practice)해 본다.', '일주일 뒤, 한 달 뒤에도 흐트러지지 않도록 주기적으로 점검하고 피드백한다.'],
        script: '"우리가 모둠 대형으로 책상을 옮길 때 15초 만에 소리 없이 옮기는 연습을 해볼 겁니다. 1번: 의자 넣기, 2번: 책상 들고 회전하기, 3번: 착석입니다. 시범 조 먼저 보여줄게요!"',
        tip: '루틴을 가르치는 데 투자한 학기 초의 10분은 1년 내내 수백 시간의 평화와 수업 몰입으로 보답받습니다.' },
      { id: 51, cat: 'ch10', name: '다시 해보기', eng: 'Do It Again', tags: ['즉각교정', '루틴유지'],
        concept: '학급 전체나 모둠이 정해진 루틴이나 전환 동작을 어수선하게 수행했을 때, 화를 내거나 잔소리하는 대신 즉시 멈추고 기준에 맞게 처음부터 다시 연습시켜 성공으로 끝맺는 기법입니다.',
        steps: ['절차가 기준에 미치지 못하면 그 자리에서 밝고 차분하게 멈춘다.', '왜 다시 하는지 이유를 짧게 말하고("의자 끄는 소리가 너무 컸어요"), 더 잘할 수 있다는 믿음을 표현한다.', '즉시 원위치로 돌아가 다시 수행하게 하고, 잘 해냈을 때 아낌없이 칭찬하며 넘어간다.'],
        script: '"잠깐 멈춤! 방금 짝 대화를 끝내고 돌아올 때 너무 시간이 오래 걸렸어요. 우리 반은 훨씬 더 멋지게 해낼 수 있습니다. 다시 짝 대화하던 상태로 돌아가서, 선생님 신호에 맞춰 3초 만에 완벽하게 멈추는 걸 다시 보여주세요!"',
        tip: '다시 해보기는 벌이 아니라 "연습(Practice)"입니다. 교사의 표정이 밝고 침착할수록 효과가 배가됩니다.' },

      // Ch 11. 높은 행동 기대치 (52~58)
      { id: 52, cat: 'ch11', name: '해야 할 일 명확히 지시하기', eng: 'What to Do', tags: ['명확한지시', '행동지도'],
        concept: '"떠들지 마", "집중해"처럼 하지 말아야 할 행동이나 추상적인 말을 하는 대신, 학생이 지금 당장 해야 할 행동을 구체적이고(Specific), 가시적이며(Observable), 순차적으로(Sequential) 알려주는 기법입니다.',
        steps: ['추상적인 요구("바르게 앉아")를 눈에 보이는 동작("두 발은 바닥에 붙이고 허리를 펴세요")으로 바꾼다.', '부정형 금지 지시 대신 긍정형 행동 지시를 사용한다.', '복잡한 지시는 한 번에 하나씩 순서대로 제시한다.'],
        script: '❌ "집중 좀 해라! 딴짓하지 마!"\n⭕ "연필을 손에 쥐고, 학습지 15쪽 맨 위 첫 번째 문장에 손가락을 짚으세요."',
        tip: '학생이 지시를 따르지 않을 때, 그것이 반항인지 아니면 무엇을 어떻게 해야 할지 몰라서인지 구분하려면 먼저 교사의 지시가 100% 구체적이어야 합니다.' },
      { id: 53, cat: 'ch11', name: '레이더와 지켜보고 있음을 드러내기', eng: 'Radar and Be Seen Looking', tags: ['예방적생활지도', '교실관찰'],
        concept: '지시를 내린 직후 교실의 사각지대가 없는 지점(파스토레의 횃대)에서 전체를 스캔하며(Radar), 교사가 모든 학생의 참여를 관심 있게 지켜보고 있음을 신체 동작으로 자연스럽게 보여주는(Be Seen Looking) 기법입니다.',
        steps: ['지시를 내린 후 곧바로 칠판을 보거나 서류를 뒤적이지 않고, 3~5초간 멈춰 서서 교실 전체를 스캔한다.', '교실 구석 가장자리(Pastore\'s Perch)에 서서 가장 넓은 시야각을 확보한다.', '고개를 천천히 돌려가며 확인하거나 긍정적으로 고개를 끄덕여 교사가 보고 있음을 인식시킨다.'],
        script: '"모두 24쪽을 펴세요." (교실 앞 모서리에서 3초간 천천히 좌우 끝까지 시선을 옮기며 스캔함) "네, 1분단부터 4분단까지 모두 책을 폈네요. 좋습니다."',
        tip: '교사가 지시만 내리고 자기 할 일만 하면 학생들은 지시가 중요하지 않다고 생각합니다. 확인하는 눈길이 지시의 완결입니다.' },
      { id: 54, cat: 'ch11', name: '기대치를 눈에 보이게 하기', eng: 'Make Expectations Visible', tags: ['시각적확인', '책무성'],
        concept: '교사가 학생들의 이행 여부를 한눈에 쉽게 확인할 수 있도록, 지시 사항에 눈에 잘 띄는 물리적 동작(연필 들어 올리기, 책 세우기 등)을 포함시키는 기법입니다.',
        steps: ['"준비됐니?"라고 묻는 대신 "준비된 사람은 자와 연필을 들어 보여주세요"라고 지시한다.', '집중해서 읽거나 들을 때 손가락으로 줄을 짚게 하는 등 가시적인 기준을 제시한다.', '눈에 보이는 행동을 즉시 인정하고 칭찬하여 주변 학생들의 동참을 유도한다.'],
        script: '"다음 받아쓰기 준비가 끝난 친구는 연필을 잡은 손을 책상 위에 수직으로 세워 선생님에게 보여주세요."',
        tip: '기대치가 눈에 보이면 교사가 순회하지 않고도 교탁에서 단 1초 만에 미준비 학생을 파악하고 도울 수 있습니다.' },
      { id: 55, cat: 'ch11', name: '최소 침입적 개입', eng: 'Least Invasive Intervention', tags: ['수업흐름보호', '비언어적개입'],
        concept: '수업 중 사소한 주의 이탈이나 규칙 위반이 발생했을 때, 수업을 중단하고 공개적으로 지적하는 대신 수업의 흐름을 깨지 않는 가장 조용하고 비침입적인 방법으로 행동을 교정하는 기법입니다.',
        steps: ['1단계(비언어적 개입): 설명을 멈추지 않은 채 눈맞춤이나 가벼운 손짓으로 신호를 보낸다.', '2단계(근접 통제): 말을 이어가면서 자연스럽게 해당 학생의 책상 옆으로 걸어가 잠시 머문다.', '3단계(익명 집단 교정 / 귓속말 개입): "아직 두 명이 연필을 들지 않았네요"라고 말하거나, 순회 중 조용히 귓속말로 알려준다.'],
        script: '(교사가 설명을 계속 이어가면서, 딴짓하는 학생의 자리 옆으로 조용히 걸어가 책상 모서리를 손끝으로 가볍게 두 번 톡톡 건드린 뒤 미소 지으며 지나감)',
        tip: '한 명의 사소한 딴짓을 잡느라 교사가 수업을 멈추고 큰 소리로 이름을 부르면, 나머지 29명의 수업 몰입까지 모두 깨져버립니다.' },
      { id: 56, cat: 'ch11', name: '단호하고 차분한 솜씨', eng: 'Firm, Calm Finesse', tags: ['교사화법', '평정심'],
        concept: '학생의 행동을 바로잡아야 할 때 감정을 내세우거나 긴장감을 고조시키지 않고, 정중하고 차분하면서도 흔들림 없는 어조로 학생이 체면을 잃지 않고 즉시 본궤도로 돌아오게 돕는 기법입니다.',
        steps: ['교정 지시를 내릴 때 목소리 톤을 오히려 평소보다 낮추고 차분하게 말한다.', '"선생님을 위해서"가 아니라 "우리 반의 배움을 위해서"라는 공동의 목적을 환기한다.', '학생이 지시를 따르면 즉시 짧게 "고마워"라고 말하고 미소 지으며 일상적인 수업으로 넘어간다.'],
        script: '"민호야, 네가 똑똑한 친구라는 걸 알기 때문에 지금 이 문제에 온전히 집중하길 바란단다. 장난감은 가방에 넣고 3번 문제를 보자. 고마워."',
        tip: '지시 끝에 붙이는 짧고 진심 어린 "고마워(Thank you)"는 학생이 반발심 없이 행동을 수정하게 만드는 윤활유 역할을 합니다.' },
      { id: 57, cat: 'ch11', name: '결과 적용의 기술', eng: 'Art of the Consequence', tags: ['일관성', '규칙적용'],
        concept: '반복적이거나 중대한 규칙 위반에 대해 후속 조치(결과)를 부여할 때, 교사가 분노를 표출하거나 길게 설교하지 않고, 빠르고 작고 일관되게 조치를 취한 뒤 학생이 곧바로 회복하여 수업에 복귀하게 돕는 기법입니다.',
        steps: ['문제가 커지기 전에 작고 비례적인 단계별 조치를 신속하게 적용한다.', '결과를 전달할 때는 중립적이고 침착한 목소리를 유지하며 공개적인 망신을 주지 않는다.', '조치를 받은 직후 학생이 다시 바른 태도를 보이면 즉시 인정해 주어 관계의 다리를 복구한다(Bounce Back).'],
        script: '(조용히 다가가 차분한 목소리로) "약속한 규칙을 어겼기 때문에 쉬는 시간에 2분간 남아서 정리하고 갑니다. 자, 이제 마음 추스르고 4번 문제부터 다시 멋지게 참여해 보자."',
        tip: '결과 부여의 목적은 학생을 고통스럽게 벌주는 것이 아니라, 잘못된 행동을 멈추고 빨리 배움의 자리로 돌아오게 하는 것입니다.' },
      { id: 58, cat: 'ch11', name: '강력한 목소리', eng: 'Strong Voice', tags: ['교사권위', '언어의경제성'],
        concept: '소리를 지르지 않고도 교사의 말에 자연스러운 권위와 신뢰가 실리도록, 불필요한 말을 줄이고(언어의 경제성), 멈춰 서서 말하며, 학생들의 잡담 소리와 경쟁하지 않는 신체·언어적 기법입니다.',
        steps: ['언어의 경제성(Economy of Language): 지시할 때 구구절절 말을 늘이지 않고 핵심만 짧고 간결하게 말한다.', '말할 때 멈춰 서기(Stand Still): 중요한 지시를 내릴 때는 걸어 다니거나 판서를 멈추고 정자세로 서서 말한다.', '소음 위로 말하지 않기(Do Not Talk Over): 학생들이 떠들고 있을 때 목소리를 높여 덮으려 하지 않고, 말을 딱 멈추고 조용해질 때까지 기다린다.'],
        script: '(학생들이 소란스러울 때) "자, 다음 활동은... (말을 뚝 멈추고 정자세로 서서 조용히 교실을 바라봄. 정적이 흐르자 낮고 또렷한 목소리로) 다음 활동은 18쪽입니다."',
        tip: '교사가 긴장하거나 화가 날수록 말이 빨라지고 길어지며 톤이 높아집니다. 권위는 오히려 느리고 낮고 짧은 말에서 나옵니다.' },

      // Ch 12. 동기 부여와 신뢰 (59~63)
      { id: 59, cat: 'ch12', name: '긍정적 프레이밍', eng: 'Positive Framing', tags: ['긍정언어', '선의전제'],
        concept: '학생들의 행동을 교정할 때 부정적인 의도를 의심하거나 비난하는 대신, 학생의 선의를 전제(Assume the Best)하고 더 나은 미래 행동을 긍정적인 언어로 묘사하여 자발적인 협조를 이끌어내는 기법입니다.',
        steps: ['선의를 전제하기: 학생이 지시를 따르지 않았을 때 "무시했다"고 단정하지 않고 "깜빡했거나 내 설명이 부족했다"고 표현한다.', '긍정적 현실 묘사하기: 안 하는 학생을 지적하기보다 잘하고 있는 다수의 행동을 먼저 소리 내어 읽어준다(Narrate the Positive).', '도전 과제 부여하기: "과연 10초 안에 해낼 수 있을지 보자!"라며 긍정적 경쟁심을 자극한다.'],
        script: '❌ "왜 이렇게 말들을 안 듣니? 조용히 하라고 몇 번 말해!"\n⭕ "잠깐 멈춤. 선생님이 이번 활동이 조용히 혼자 하는 활동이라는 걸 명확히 말하지 않았나 보네요. 지금 바로 침묵 모드로 고쳐봅시다."',
        tip: '교사가 학생들의 행동을 늘 선의로 해석해 주면, 학생들도 교실을 따뜻하고 공정한 공간으로 느끼며 스스로 좋은 모습을 보여주려 노력합니다.' },
      { id: 60, cat: 'ch12', name: '정밀한 칭찬', eng: 'Precise Praise', tags: ['피드백', '동기부여'],
        concept: '당연한 규칙 준수와 진짜 뛰어난 노력을 구분하고, 막연하게 "잘했어"라고 하기보다 학생이 사용한 구체적인 학습 전략과 노력을 정확히 짚어 칭찬함으로써 행동을 강화하는 기법입니다.',
        steps: ['기본적인 지시 이행에는 "책 펴줘서 고마워"처럼 짧은 인정(Acknowledgment)만 건네고 과도한 칭찬을 남발하지 않는다.', '학생이 뛰어난 노력이나 학문적 성취를 보였을 때 무엇을 어떻게 잘했는지 구체적인 행동을 짚어 칭찬한다.', '칭찬은 모든 학생이 듣고 본받을 수 있도록 또렷하게, 교정은 학생의 자존감을 위해 조용히 전달한다.'],
        script: '"지민이 풀이가 정말 인상적이네요! 시간이 남았을 때 그냥 쉬지 않고 네 가지 보기를 전부 식에 대입해서 검산까지 마친 전략이 아주 훌륭했습니다."',
        tip: '숨만 쉬어도 "최고야! 천재야!"라고 남발하는 칭찬은 칭찬의 가치를 떨어뜨리고 학생을 나약하게 만듭니다. 구체적인 과정과 전략을 칭찬하세요.' },
      { id: 61, cat: 'ch12', name: '따뜻함과 엄격함의 조화', eng: 'Warm/Strict', tags: ['사랑이담긴책임감', '교사태도'],
        concept: '교사는 따뜻하거나 엄격하거나 둘 중 하나여야 한다는 통념을 깨고, 한결같은 온화함과 인간미(Warm)를 유지하면서도 동시에 높은 학업·행동 기준(Strict)을 타협 없이 요구하는 기법입니다.',
        steps: ['행동을 교정할 때 말의 내용은 단호하고 명확하게 하되, 표정과 비언어적 태도는 따뜻하게 유지한다.', '잘못된 "행동"과 소중한 "학생의 인격"을 분리하여 전달한다.', '높은 기준을 요구하는 이유가 "너를 진심으로 아끼고 믿기 때문(사랑이 담긴 책임감)"임을 알게 한다.'],
        script: '(따뜻한 미소와 부드러운 목소리로) "현우야, 선생님은 네가 얼마나 깊은 생각을 가진 사람인지 잘 알아. 그래서 이렇게 대충 한 줄로 적은 답은 받을 수가 없단다. 다시 자리에 가서 네 실력에 걸맞은 세 문장으로 완성해 오렴."',
        tip: '따뜻함 없는 엄격함은 차가운 독재가 되고, 엄격함 없는 따뜻함은 무책임한 방임이 됩니다. 최고의 교사는 언제나 두 가지를 동시에 지닙니다.' },
      { id: 62, cat: 'ch12', name: '감정적 항상성', eng: 'Emotional Constancy', tags: ['정서적안전감', '감정조절'],
        concept: '학생의 실수나 돌발 행동 앞에서도 교사가 기분에 따라 화를 내거나 감정의 기복을 보이지 않고, 언제나 예측 가능하고 차분하며 안정된 정서 상태를 유지하여 교실의 신뢰를 지키는 기법입니다.',
        steps: ['교실의 갈등 상황을 교사 개인에 대한 공격으로 받아들이지 않는다.', '학생의 목소리가 커질수록 교사의 목소리는 더 낮고 차분하게 유지한다.', '칭찬과 신뢰는 아낌없이 주되, 실망이나 짜증은 절제하여 학생들이 교사의 눈치를 보며 불안해하지 않게 한다.'],
        script: '(학생이 짜증을 내며 책을 덮었을 때 흔들림 없이 평온한 어조로) "문제가 안 풀려서 많이 답답했구나. 숨 한번 크게 쉬고, 선생님이랑 1번 식부터 차근차근 같이 보자."',
        tip: '신뢰는 예측 가능성에서 자라납니다. 교사가 언제나 한결같은 바위처럼 자리를 지켜줄 때 학생들은 안심하고 도전에 나섭니다.' },
      { id: 63, cat: 'ch12', name: '배움의 기쁨', eng: 'Joy Factor', tags: ['즐거운교실', '학습동기'],
        concept: '배움과 노력이 고되고 지루한 것이 아니라 그 자체로 즐겁고 신나는 일임을 느끼도록, 노래와 구호, 유머, 서스펜스, 동료에 대한 뜨거운 축하를 수업 속에 자연스럽게 녹여내는 기법입니다.',
        steps: ['복습이나 전환 루틴에 리듬감 있는 짧은 구호나 챈트를 활용한다.', '어려운 문제를 해결한 친구에게 학급만의 특별한 박수나 환호를 보내며 성취의 기쁨을 함께 나눈다.', '탄탄한 질서와 루틴을 바탕으로 유쾌한 유머와 지적 호기심이 살아 숨 쉬게 한다.'],
        script: '"자, 오늘의 최고 난도 문제를 민지가 완벽하게 풀어냈습니다! 우리 반 시그니처 박수, 번개 박수 발사! 짝짝-짝짝짝-우르릉 쾅! 민지 최고!"',
        tip: '배움의 기쁨은 규율의 반대말이 아닙니다. 역설적이게도 교실의 절차와 질서가 가장 탄탄할 때 교사와 학생 모두 가장 마음껏 웃고 즐길 수 있습니다.' }
    ];


